<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Läuft ausschließlich, solange eine Bluetooth-Verbindung zum
             Band besteht (Start/Stop über MomentumBleServicePlugin, siehe
             dort) – schützt die Verbindung davor, dass Android den Prozess
             im Hintergrund/bei gesperrtem Bildschirm beendet. exported
             bewusst false: nur die eigene App darf ihn starten/stoppen. -->
        <service
            android:name=".MomentumBleForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Für den Foreground Service, der die Bluetooth-Verbindung zum Band
         schützt (MomentumBleForegroundService). FOREGROUND_SERVICE ist die
         allgemeine Grundberechtigung, FOREGROUND_SERVICE_CONNECTED_DEVICE
         die seit Android 14 zusätzlich geforderte, zum deklarierten
         android:foregroundServiceType="connectedDevice" passende
         Typ-Berechtigung. POST_NOTIFICATIONS wird ab Android 13 zur
         Laufzeit benötigt, damit die Pflicht-Benachrichtigung
         ("Momentum misst deinen Puls") überhaupt angezeigt wird. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Kamera für das Scannen des Kopplungs-QR-Codes
         (@capacitor-mlkit/barcode-scanning, siehe Abschnitt VERBINDUNG in
         chat.html).

         Muss HIER stehen: Anders als beim Bluetooth-Plugin bringt das
         Barcode-Plugin die Berechtigung NICHT mit. Sein eigenes Manifest
         ist leer, und aus CameraX kommt nur ein MetadataHolderService –
         im zusammengeführten Manifest fehlte CAMERA nachweislich, geprüft
         nach einem processDebugMainManifest-Lauf.

         required="false": Der QR-Code ist eine Ergänzung, kein Ersatz.
         Der sechsstellige Zahlencode funktioniert weiterhin vollständig,
         deshalb soll die App auch auf Geräten ohne Kamera installierbar
         bleiben. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
